---
import PrivateBetaComponent from "./private-beta.mdx"
import ActiveMonitoringComponent from "./active-monitoring.mdx"

export type Props = {
  callout?: "privateBeta" | "activeMonitoring"
}

const { callout } = Astro.props as Props
---

{callout === "privateBeta" && <PrivateBetaComponent />}
{callout === "activeMonitoring" && <ActiveMonitoringComponent />}
