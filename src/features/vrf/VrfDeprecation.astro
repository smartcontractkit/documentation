---
import V1Deprecation from "./v1/common/deprecation.mdx"
import V2Deprecation from "./v2/common/deprecation.mdx"
import V2_5Deprecation from "./v2-5/v1-v2-shutdown.mdx"

export type Props = {
  version: "v1" | "v2" | "v2-5"
}

const { version } = Astro.props as Props
---

{version === "v1" && <V1Deprecation />}
{version === "v2" && <V2Deprecation />}
{version === "v2-5" && <V2_5Deprecation />}
