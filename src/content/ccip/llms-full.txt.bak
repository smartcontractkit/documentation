  address localToken,
  uint64 destChainSelector,
  uint16 blockConfirmationRequested,
  bytes calldata tokenArgs
)
  external
  view
  returns (TokenTransferFeeConfig memory feeConfig);
```

***

### getFee

```solidity
function getFee(
  address localToken,
  uint64 destChainSelector,
  uint256 amount,
  address feeToken,
  uint16 blockConfirmationRequested,
  bytes calldata tokenArgs
)
  external
  view
  returns (
    uint256 feeUSDCents,
    uint32 destGasOverhead,
    uint32 destBytesOverhead,
    uint16 tokenFeeBps,
    bool isEnabled
  );
```

***

### getRemoteToken

```solidity
