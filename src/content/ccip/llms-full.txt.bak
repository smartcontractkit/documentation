  uint64 localChainSelector;
  uint16 gasForCallExactCheck;
  IRMNRemote rmnRemote;
  address tokenAdminRegistry;
  uint32 maxGasBufferToUpdateState;
}
```

### `SourceChainConfig`

```solidity
