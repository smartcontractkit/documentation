---
import { SOLUTION_PRODUCTS } from "~/config/solutions/index.ts"
import type { Solution } from "~/config/solutions/index.ts"

interface Props {
  solution: Solution
}
const { solution } = Astro.props
const products = solution.products.map((p) => SOLUTION_PRODUCTS[p]).filter(Boolean)
---

<div class="solution-summary">
  <p class="solution-summary__description">{solution.description}</p>

  <div class="solution-summary__meta">
    {
      products.length > 0 && (
        <div class="solution-summary__products">
          {products.map((p) => (
            <a class="product-badge" href={p.href}>
              {p.label}
            </a>
          ))}
        </div>
      )
    }
    {
      solution.categories.length > 0 && (
        <div class="solution-summary__categories">
          {solution.categories.map((c) => (
            <span class="category-chip">{c}</span>
          ))}
        </div>
      )
    }
    {
      solution.repoUrl && (
        <a class="solution-summary__repo" href={solution.repoUrl} target="_blank" rel="noopener">
          View the reference implementation
        </a>
      )
    }
  </div>
</div>

<style>
  .solution-summary {
    margin: 0 0 var(--space-8x) 0;
    padding: var(--space-6x);
    background: #fafbfd;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
  }

  .solution-summary__description {
    margin: 0 0 var(--space-4x) 0;
    font-size: 15px;
    line-height: 1.6;
    color: #5a6175;
  }

  .solution-summary__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3x);
  }

  .solution-summary__products,
  .solution-summary__categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2x);
  }

  .product-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    background: #ffffff;
    color: #5a6175;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .product-badge:hover {
    color: var(--blue-600, #0847f7);
    border-color: var(--blue-600, #0847f7);
  }

  .category-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    background: #ffffff;
    color: #5a6175;
    border: 1px solid #e5e7eb;
  }

  .solution-summary__repo {
    margin-left: auto;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-link, #0847f7);
    text-decoration: none;
  }

  .solution-summary__repo:hover {
    text-decoration: underline;
  }

  @media (max-width: 50em) {
    .solution-summary__repo {
      margin-left: 0;
    }
  }
</style>
