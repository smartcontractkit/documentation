---
import { SOLUTION_PRODUCTS } from "~/config/solutions/index.ts"
import type { Solution } from "~/config/solutions/index.ts"
import SolutionGitHubButton from "./SolutionGitHubButton.astro"

interface Props {
  solution: Solution
}
const { solution } = Astro.props
const products = solution.products.map((p) => SOLUTION_PRODUCTS[p]).filter(Boolean)
---

<div class="solution-summary">
  <h2 class="solution-summary__title">What is it</h2>
  <p class="solution-summary__description">{solution.description}</p>

  <div class="solution-summary__meta">
    {
      products.length > 0 && (
        <div class="solution-summary__products">
          {products.map((p) => (
            <a class="product-badge" href={p.href}>
              {p.label}
            </a>
          ))}
        </div>
      )
    }
    {
      solution.categories.length > 0 && (
        <div class="solution-summary__categories">
          {solution.categories.map((c) => (
            <span class="category-chip">{c}</span>
          ))}
        </div>
      )
    }
    {solution.repoUrl && <SolutionGitHubButton class="solution-summary__repo" href={solution.repoUrl} />}
  </div>
</div>

<style>
  .solution-summary {
    margin: 0 0 var(--space-8x) 0;
    padding: var(--space-6x);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .solution-summary__description {
    margin: 0 0 var(--space-4x) 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .solution-summary__title {
    margin: 0 0 var(--space-3x) 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--foreground);
  }

  .solution-summary__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3x);
  }

  .solution-summary__products,
  .solution-summary__categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2x);
  }

  .product-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    background: var(--background);
    color: var(--color-text-primary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .product-badge:hover {
    color: var(--text-accent);
    border-color: var(--blue-600, #0847f7);
  }

  .category-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    background: var(--background);
    color: var(--color-text-primary);
    border: 1px solid var(--border);
  }

  .solution-summary__repo {
    margin-left: auto;
  }

  @media (max-width: 50em) {
    .solution-summary__repo {
      margin-left: 0;
    }
  }
</style>
