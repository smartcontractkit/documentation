---
// Rendered by SolutionLayout at the end of the main column on EVERY solution page.
// Never import this from an MDX file: legal compliance must not depend on an author
// remembering to paste it.
import alertIcon from "~/components/Alert/Assets/alert-icon.svg"
---

<aside class="solution-disclaimer">
  <div class="solution-disclaimer__header">
    <img src={alertIcon.src} alt="" class="solution-disclaimer__icon" />
    <h2 class="solution-disclaimer__title">Disclaimer</h2>
  </div>
  <p class="solution-disclaimer__text">
    This solution represents an educational example to use a Chainlink system, product, or service and is provided to
    demonstrate how to interact with Chainlink's systems, products, and services to integrate them into your own. This
    solution is provided "AS IS" and "AS AVAILABLE" without warranties of any kind, it has not been audited, and it may
    be missing key checks or error handling to make the usage of the system, product or service more clear. Do not use
    the code in this example in a production environment without completing your own audits and application of best
    practices. Neither Chainlink Labs, the Chainlink Foundation, nor Chainlink node operators are responsible for
    unintended outputs that are generated due to errors in code.
  </p>
</aside>

<style>
  .solution-disclaimer {
    margin-top: var(--space-10x);
    padding-top: var(--space-6x);
    border-top: 1px solid #e5e7eb;
  }

  .solution-disclaimer__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-3x);
  }

  .solution-disclaimer__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .solution-disclaimer__title {
    margin: 0 !important;
    font-size: 10px;
    font-weight: 500;
    line-height: 130%;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gray-900, #141921);
  }

  .solution-disclaimer__text {
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
    color: #5a5a5a;
  }
</style>
