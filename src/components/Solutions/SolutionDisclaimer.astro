---
// Rendered by SolutionLayout at the end of the main column on EVERY solution page.
// Never import this from an MDX file: legal compliance must not depend on an author
// remembering to paste it.
import { SOLUTION_DISCLAIMER } from "~/config/solutions/disclaimer.ts"
import alertIcon from "~/components/Alert/Assets/alert-icon.svg"
---

<aside class="solution-disclaimer">
  <div class="solution-disclaimer__header">
    <img src={alertIcon.src} alt="" class="solution-disclaimer__icon" />
    <h2 class="solution-disclaimer__title">Disclaimer</h2>
  </div>
  <p class="solution-disclaimer__text">
    {SOLUTION_DISCLAIMER.beforeTerms}{" "}<a href={SOLUTION_DISCLAIMER.termsUrl}>{SOLUTION_DISCLAIMER.termsLabel}</a>{
      SOLUTION_DISCLAIMER.afterTerms
    }
  </p>
</aside>

<style>
  .solution-disclaimer {
    margin-top: var(--space-10x);
    padding-top: var(--space-6x);
    border-top: 1px solid #e5e7eb;
  }

  .solution-disclaimer__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-3x);
  }

  .solution-disclaimer__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .solution-disclaimer__title {
    margin: 0 !important;
    font-size: 10px;
    font-weight: 500;
    line-height: 130%;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gray-900, #141921);
  }

  .solution-disclaimer__text {
    max-width: none;
    margin: 0;
    font-size: 12px;
    line-height: 1.7;
    color: #5a5a5a;
    text-align: justify;
  }

  .solution-disclaimer__text a {
    color: var(--color-text-link, #0847f7);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .solution-disclaimer__text a:hover {
    color: var(--color-text-link-hover, #0639c7);
  }

  .solution-disclaimer__text a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
