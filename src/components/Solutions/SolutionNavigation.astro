---
import { SOLUTION_PRODUCTS, SOLUTIONS_HUB_ENABLED } from "~/config/solutions/index.ts"
import type { Solution } from "~/config/solutions/index.ts"

interface Props {
  solution: Solution
}
const { solution } = Astro.props

const products = solution.products.map((p) => SOLUTION_PRODUCTS[p]).filter(Boolean)
---

<div class="solution-nav">
  <div class="solution-nav-inner">
    {
      SOLUTIONS_HUB_ENABLED ? (
        <nav class="solution-breadcrumb" aria-label="Breadcrumb">
          {/*
           * The breadcrumb links back to the hub. The product badges below are the other
           * return path: a reader who arrived from the CCIP sidebar can go back to CCIP.
           */}
          <a class="breadcrumb-root" href="/solutions">
            All Chainlink Solutions
          </a>
          <span class="breadcrumb-separator" aria-hidden="true">
            /
          </span>
          <span class="breadcrumb-current" aria-current="page">
            {solution.title}
          </span>
        </nav>
      ) : (
        /* No hub to go back to while SOLUTIONS_HUB_ENABLED is false: title only, no breadcrumb. */
        <div class="solution-breadcrumb">
          <span class="breadcrumb-current">{solution.title}</span>
        </div>
      )
    }
    {
      products.length > 0 && (
        <span class="solution-products">
          <span class="uses-label">Uses</span>
          {products.map((p) => (
            <a class="product-badge" href={p.href}>
              {p.label}
            </a>
          ))}
        </span>
      )
    }
    {
      solution.repoUrl && (
        <a class="repo-link" href={solution.repoUrl} target="_blank" rel="noopener">
          <svg class="github-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
          </svg>
          View on GitHub
        </a>
      )
    }
  </div>
</div>

<style>
  .solution-nav {
    position: sticky;
    top: var(--space-16x);
    z-index: 5;
    padding: var(--space-4x) 0;
    background: rgba(250, 250, 251, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid #ecedef;
    box-shadow: var(--space-0x) var(--space-1x) var(--space-3x) var(--space-0x) #0000000f;
    /* Mirrors DocsNavigationDesktop: collapses to top: 0 when the site header hides. */
    transition: top 0.5s ease;
  }

  .solution-nav.is-header-hidden {
    top: 0;
  }

  .solution-nav-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4x);
    width: 100%;
    margin: 0 auto;
    max-width: min(calc(1505px - 2 * var(--space-4x)), calc(100% - 2 * var(--space-4x)));
    padding: 0 var(--space-4x);
  }

  .repo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 6px 14px;
    background: #0847f7;
    color: white;
    font-size: 13px;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid #0847f7;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .repo-link:hover {
    background: #0639c7;
    border-color: #0639c7;
    color: white;
  }

  .solution-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2x);
    min-width: 0;
  }

  .breadcrumb-root {
    font-size: 13px;
    font-weight: 500;
    color: var(--Page-Foreground-Muted, #6c7585);
    text-decoration: none;
    white-space: nowrap;
  }

  .breadcrumb-root:hover {
    color: var(--blue-600, #0847f7);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    font-size: 13px;
    color: #9ca3af;
  }

  .breadcrumb-current {
    font-size: 16px;
    font-weight: 700;
    color: #0b101c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
  }

  .solution-products {
    display: flex;
    align-items: center;
    gap: var(--space-2x);
    margin-left: auto;
  }

  .uses-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: #6c7585;
    line-height: 1;
  }

  .product-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    background: #f5f7fa;
    color: #5a6175;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .product-badge:hover {
    color: var(--blue-600, #0847f7);
    border-color: var(--blue-600, #0847f7);
  }

  @media (max-width: 50em) {
    .uses-label,
    .repo-link {
      display: none;
    }

    .breadcrumb-root,
    .breadcrumb-separator {
      font-size: 12px;
    }

    .breadcrumb-current {
      font-size: 14px;
    }
  }
</style>

<script>
  // The site header hides on scroll-down and publishes its state through the navBarInfo
  // nanostore (see src/components/Header/NavBar.tsx). DocsNavigation subscribes to it as a
  // React island; this bar is a plain Astro component, so subscribe in vanilla JS instead.
  // Same contract: when the header hides, the bar sticks to the top of the viewport.
  import { navBarInfo } from "~/components/Header/useNavBar/navBarStore.ts"

  const bar = document.querySelector(".solution-nav")

  navBarInfo.subscribe((info) => {
    bar?.classList.toggle("is-header-hidden", !!info?.hidden)
  })
</script>
