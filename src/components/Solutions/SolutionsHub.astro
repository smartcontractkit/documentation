---
import BaseLayout from "~/layouts/BaseLayout.astro"
import SolutionCard from "~/components/Solutions/SolutionCard.astro"
import { getAllSolutions } from "~/config/solutions/index.ts"

const solutions = getAllSolutions()
---

<BaseLayout
  title="Chainlink Product Solutions | Chainlink Documentation"
  metadata={{
    title: "Chainlink Product Solutions",
    description: "Explore Chainlink Product Solutions, which combine multiple products to help you build faster.",
  }}
>
  <main class="hub-page">
    <!-- Hero Section -->
    <header class="hero">
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-title">Chainlink Product Solutions</h1>
          <p class="hero-description">Solutions that combine multiple Chainlink products to help you build faster.</p>
        </div>
      </div>
    </header>

    <!-- Solutions Section -->
    <div class="solutions-container">
      <section class="solution-section">
        <div class="card-grid" id="solution-grid">
          {solutions.map((solution) => <SolutionCard {solution} />)}
        </div>
      </section>
    </div>
  </main>

  <style>
    :global(body:has(.hub-page)) {
      background-color: #f5f7fa;
    }

    .hub-page {
      background-color: #f5f7fa;
      margin: 0;
      padding: 0;
    }

    /* Hero Section */
    .hero {
      position: relative;
      overflow: hidden;
      background: #2563eb;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url("/images/cre-templates/hero-pattern.webp");
      background-size: cover;
      background-position: right center;
      background-repeat: no-repeat;
      z-index: 0;
    }

    .hero::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 70%;
      bottom: 0;
      background: linear-gradient(
        to right,
        rgba(37, 99, 235, 0.95) 10%,
        rgba(37, 99, 235, 0.85) 10%,
        rgba(37, 99, 235, 0) 50%
      );
      z-index: 1;
    }

    .hero-container {
      /* Match the site header container. Taller than the CRE Templates hero on purpose:
         the background pattern needs room to breathe around the title. */
      max-width: var(--max-width, 90rem);
      margin: 0 auto;
      padding: 112px var(--doc-padding, 2rem);
      display: flex;
      align-items: center;
      justify-content: flex-start;
      position: relative;
      min-height: 320px;
      z-index: 2;
    }

    .hero-content {
      position: relative;
      max-width: 680px;
    }

    .hero-title {
      font-size: 36px;
      font-weight: 500;
      color: white;
      margin: 0 0 16px 0;
      line-height: 1.2;
    }

    .hero-description {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.7;
      margin: 0;
    }

    /* Solutions Section */
    .solutions-container {
      max-width: var(--max-width, 90rem);
      margin: 0 auto;
      padding: 48px var(--doc-padding, 2rem) 80px;
    }

    .solution-section {
      width: 100%;
    }

    /* Card Grid */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border-left: 1px solid #e5e7eb;
      border-top: 1px solid #e5e7eb;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .card-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .hero-container {
        padding: 72px 24px;
        min-height: auto;
      }

      .hero-title {
        font-size: 28px;
      }

      .hero-description {
        font-size: 14px;
      }

      .solutions-container {
        padding: 32px 24px 64px;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
