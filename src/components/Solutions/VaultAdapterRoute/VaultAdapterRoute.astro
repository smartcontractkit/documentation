---
/**
 * One deposit or redemption route, drawn in full on three columns (Source chain, Chainlink CCIP,
 * Hub chain). `mode="manual"` draws the route without the adapter; `mode="adapter"` draws it with
 * the adapter.
 *
 * Usage in MDX:
 *   import VaultAdapterRoute from "@components/Solutions/VaultAdapterRoute/VaultAdapterRoute.astro"
 *   <VaultAdapterRoute mode="manual">…literal Markdown fallback…</VaultAdapterRoute>
 *   <VaultAdapterRoute mode="adapter">…literal Markdown fallback…</VaultAdapterRoute>
 *
 * A native radio group (Deposit | Redeem) reshapes the route, and every other route on the page
 * switches with it. Numbered stops are buttons that write an inspector line, and the arrows beside
 * the explanation walk the route in order. Step 1 is selected on the server-rendered first paint,
 * so the explanation panel and the selected stop are visible at once.
 *
 * Styles are global on purpose: the element re-renders badges at runtime. Every class is `vac-`.
 * Several rules carry three class names so they outrank the article's global list and
 * max-width rules (PageContent.astro), which would otherwise leak into the drawing.
 */
import { DEFAULT_SCENARIO, isMode } from "./vaultAdapterRouteModel.ts"
import type { Mode, Scenario } from "./vaultAdapterRouteModel.ts"
import { renderRoute } from "./vaultAdapterRouteView.ts"

interface Props {
  /** "manual" draws the route without the adapter; "adapter" draws it with the adapter. */
  mode: Mode
}

const { mode } = Astro.props
if (!isMode(mode)) {
  throw new Error(`VaultAdapterRoute: mode must be "manual" or "adapter", got ${JSON.stringify(mode)}`)
}

const uid = "vac-" + Math.random().toString(36).slice(2, 9)
const scenario: Scenario = { flow: DEFAULT_SCENARIO.flow, mode }
const interactive = renderRoute(uid, scenario)
---

<vault-adapter-route
  class="vac"
  data-flow={scenario.flow}
  data-mode={scenario.mode}
  role="group"
  aria-labelledby={uid + "-title"}
>
  <Fragment set:html={interactive} />
  {/* The literal Markdown children: not shown on screen, but kept for print, Copy page and the TXT export. */}
  <div class="vac-text" hidden><slot /></div>
</vault-adapter-route>

<style is:global>
  .vac {
    /*
     * Diagram colours. These are the light-mode values; `html.dark .vac` below swaps them.
     * Everything else uses site tokens (--background, --foreground, --border, --muted, --brand)
     * that already switch with the theme.
     */
    --vac-accent-surface: var(--surface-accent, #eff6ff);
    --vac-accent-halo: var(--surface-accent-strong, #dcebff);
    --vac-accent-text: var(--brand, #0847f7);
    --vac-token-bg: var(--green-200, #b9f1cc);
    --vac-token-edge: var(--foreground, #141921);
    --vac-token-text: var(--foreground, #141921);
    --vac-payload-bg: var(--blue-100, #dcebff);
    --vac-payload-text: var(--foreground, #141921);

    display: block;
    container: vac / inline-size;
    isolation: isolate;
    color-scheme: light;
    border: 1px solid var(--border, #e4e8ed);
    border-radius: 4px;
    background: var(--background, #ffffff);
    color: var(--foreground, #141921);
    font-family: var(--font-family-text, "Inter", Arial, sans-serif);
    text-align: left;
  }
  /* Dark mode (html.dark, set by ThemeToggle). Tints follow src/styles/dark.css. */
  html.dark .vac {
    color-scheme: dark;
    --vac-accent-halo: var(--dark-tint-blue-stronger);
    --vac-accent-text: var(--text-accent);
    /* Opaque tints: the token tag sits across a node border, so it must hide what is under it. */
    --vac-token-bg: color-mix(in srgb, var(--green-500) 16%, var(--background));
    --vac-token-edge: var(--dark-edge-green);
    --vac-token-text: var(--dark-text-green);
    --vac-payload-bg: color-mix(in srgb, var(--blue-500) 16%, var(--background));
    --vac-payload-text: var(--blue-200);
  }
  .vac *,
  .vac *::before,
  .vac *::after {
    box-sizing: border-box;
  }

  /* Resets apply to the drawing only; the slotted transcript keeps the article's styling. */
  .vac :where(.vac-interactive) p,
  .vac :where(.vac-interactive) span,
  .vac :where(.vac-interactive) label,
  .vac :where(.vac-interactive) button,
  .vac :where(.vac-interactive) li,
  .vac :where(.vac-interactive) strong,
  .vac :where(.vac-interactive) em {
    margin: 0;
    font-family: inherit;
    font-size: 14px;
    line-height: 20px;
  }
  .vac .vac-interactive ol {
    padding: 0;
    list-style: none;
  }
  .vac :where(.vac-interactive) ol {
    margin: 0;
  }
  .vac .vac-interactive ol > li {
    list-style: none;
  }
  .vac .vac-interactive .vac-micro li,
  .vac .vac-interactive .vac-micro li > * {
    margin: 0;
  }
  .vac .vac-interactive svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .vac .vac-leg-arrow,
  .vac .vac-stops {
    max-width: none;
  }

  /* Header band: the Deposit | Redeem toggle and Reset, on the right. The route name is in the row. */
  .vac-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 8px 12px;
    min-height: 40px;
    padding: 6px 8px 6px 16px;
    border-bottom: 1px solid var(--border, #e4e8ed);
    border-radius: 3px 3px 0 0;
    background: var(--muted, #f5f7fa);
  }
  .vac .vac-interactive .vac-reset {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 8px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-link, #0847f7);
    font-weight: 600;
    cursor: pointer;
  }
  .vac .vac-reset:hover {
    background: var(--muted-more, #e4e8ed);
  }
  .vac .vac-reset:disabled {
    cursor: default;
  }
  .vac-seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 2px;
    border: 1px solid var(--border, #e4e8ed);
    border-radius: 4px;
    background: var(--background, #ffffff);
  }
  .vac .vac-option {
    position: relative;
    display: inline-flex;
    min-width: 0;
    cursor: pointer;
  }
  .vac .vac-option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .vac .vac-option input:disabled {
    cursor: default;
  }
  .vac .vac-option-text {
    display: inline-flex;
    flex: 1 1 auto;
    align-items: center;
    min-height: 28px;
    padding: 3px 10px;
    border-radius: 3px;
    color: var(--color-text-primary, #4e5560);
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
  }
  .vac .vac-option input:checked + .vac-option-text {
    background: var(--vac-accent-surface);
    box-shadow: inset 0 0 0 1px var(--brand, #0847f7);
    color: var(--vac-accent-text);
  }
  .vac .vac-option input:focus-visible + .vac-option-text {
    outline: 2px solid var(--brand, #0847f7);
    outline-offset: 2px;
  }

  /* Column strip and tracks share one grid */
  .vac-columns,
  .vac-track {
    display: grid;
    grid-template-columns: minmax(100px, 1fr) 62px minmax(0, 1.55fr);
  }
  .vac-columns {
    margin: 12px 16px 0;
    border: 1px solid var(--border, #e4e8ed);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
    overflow: hidden;
  }
  .vac .vac-col {
    padding: 6px 10px;
    background: var(--background-alt, #fafbfc);
    color: var(--color-text-primary, #4e5560);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .vac .vac-col em {
    display: none;
    color: var(--color-text-primary, #4e5560);
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 16px;
    text-transform: none;
  }
  .vac .vac-col-ccip {
    padding-inline: 4px;
    border-inline: 1px dashed var(--foreground, #141921);
    color: var(--foreground, #141921);
    font-size: 11px;
    letter-spacing: 0;
    text-align: center;
  }
  /* "Chainlink CCIP" does not fit the narrow 62px column, so it reads "CCIP" until the wide layout. */
  .vac .vac-col-ccip span {
    font: inherit;
    letter-spacing: inherit;
  }
  .vac .vac-col-full {
    display: none;
  }

  /* The route row closes the box the column strip opens. */
  .vac-row {
    margin: 0 16px;
    border: 1px solid var(--border, #e4e8ed);
    border-radius: 0 0 4px 4px;
  }
  /* Head, track and explanation sit apart at the article's section rhythm (PageContent.astro). */
  .vac .vac-row > * {
    margin-top: var(--space-5x, 20px);
  }
  .vac-row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 8px 12px;
    padding: 10px 12px 8px;
    border-bottom: 1px solid var(--border, #e4e8ed);
    background: var(--background, #ffffff);
  }
  .vac-row-titles {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .vac .vac-row-name {
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
  }
  .vac .vac-row-count {
    font-size: 28px;
    font-weight: 600;
    line-height: 36px;
  }
  .vac .vac-row-number {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    font-variant-numeric: tabular-nums;
  }
  .vac .vac-row-unit {
    color: var(--color-text-primary, #4e5560);
    font-size: 14px;
    font-weight: 400;
  }
  .vac .vac-row-meta {
    color: var(--color-text-primary, #4e5560);
    font-size: 12px;
    line-height: 16px;
    text-wrap: pretty;
  }
  .vac .vac-reset:focus-visible,
  .vac .vac-step-btn:focus-visible {
    outline: 2px solid var(--brand, #0847f7);
    outline-offset: 2px;
  }

  .vac-cell {
    display: grid;
    align-content: center;
    gap: 8px;
    min-width: 0;
    padding: 18px 6px 10px;
    background: var(--background-alt, #fafbfc);
  }
  .vac-cell-ccip {
    gap: 10px;
    padding-inline: 0;
    border-inline: 1px dashed var(--foreground, #141921);
  }
  .vac-cell-hub {
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    align-items: stretch;
    justify-items: stretch;
  }
  .vac-cell-hub .vac-link {
    justify-self: center;
  }

  /* Nodes */
  .vac-node {
    position: relative;
    display: grid;
    gap: 3px;
    justify-items: center;
    align-content: center;
    min-width: 0;
    padding: 14px 6px 10px;
    border: 1.5px solid var(--foreground, #141921);
    border-radius: 4px;
    background: var(--background, #ffffff);
    text-align: center;
  }
  .vac .vac-node-icon svg {
    width: 22px;
    height: 22px;
  }
  .vac .vac-node-name {
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
  }
  .vac .vac-node-sub,
  .vac .vac-node-note,
  .vac .vac-node-note span {
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    line-height: 14px;
  }
  .vac .vac-node-note {
    display: inline;
  }
  .vac .vac-node-note svg {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 4px;
    color: var(--foreground, #141921);
    vertical-align: -3px;
  }
  .vac-node-adapter {
    border-color: var(--brand, #0847f7);
    border-width: 2px;
  }
  .vac .vac-micro {
    display: grid;
    gap: 2px;
    width: 100%;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid var(--border, #e4e8ed);
    text-align: left;
  }
  .vac .vac-micro li {
    display: flex;
    gap: 6px;
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    line-height: 14px;
  }
  .vac .vac-micro-letter {
    flex: none;
    width: 12px;
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    font-weight: 600;
    line-height: 14px;
  }
  .vac .vac-node[data-active="true"],
  .vac .vac-leg[data-active="true"] .vac-leg-line {
    box-shadow: 0 0 0 3px var(--vac-accent-halo);
  }
  .vac .vac-node[data-active="true"] {
    background: var(--vac-accent-surface);
  }
  .vac .vac-node[data-active="true"]::after {
    content: attr(data-token);
    position: absolute;
    bottom: -9px;
    left: 6px;
    padding: 0 7px;
    border-radius: 9px;
    background: var(--vac-token-bg);
    box-shadow: inset 0 0 0 1px var(--vac-token-edge);
    color: var(--vac-token-text);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
  }

  /* Stop badges (buttons) */
  .vac-stops {
    position: absolute;
    top: -11px;
    right: 6px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 3px;
    max-width: calc(100% - 12px);
  }
  .vac .vac-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .vac button.vac-badge {
    cursor: pointer;
  }
  .vac button.vac-badge:hover:not(:disabled):not([data-active="true"]) {
    box-shadow:
      inset 0 0 0 2px var(--brand, #0847f7),
      0 0 0 3px var(--vac-accent-halo);
    transform: translateY(-1px);
  }
  .vac button.vac-badge:disabled {
    cursor: default;
  }
  .vac .vac-badge[data-kind="send"] {
    background: var(--brand, #0847f7);
    color: var(--primary-foreground, #ffffff);
  }
  .vac .vac-badge[data-kind="approval"] {
    background: var(--background, #ffffff);
    box-shadow: inset 0 0 0 2px var(--brand, #0847f7);
    color: var(--brand, #0847f7);
  }
  /* Selected stop: page ink with the page colour as text, so it inverts with the theme. */
  .vac .vac-badge[data-active="true"] {
    background: var(--foreground, #141921);
    box-shadow: none;
    color: var(--background, #ffffff);
  }
  .vac button.vac-badge:focus-visible {
    outline: 2px solid var(--brand, #0847f7);
    outline-offset: 2px;
  }

  /* CCIP legs, horizontal in both rows */
  .vac-leg {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    justify-items: center;
    min-width: 0;
  }
  .vac-leg-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
    max-width: 100%;
    min-width: 0;
    padding: 0 4px;
  }
  .vac .vac-chip {
    max-width: 100%;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vac .vac-chip-token {
    background: var(--vac-token-bg);
    box-shadow: inset 0 0 0 1px var(--vac-token-edge);
    color: var(--vac-token-text);
  }
  .vac .vac-chip-payload {
    background: var(--vac-payload-bg);
    box-shadow: inset 0 0 0 1px var(--brand, #0847f7);
    color: var(--vac-payload-text);
  }
  .vac .vac-chip-full {
    display: none;
  }
  .vac-leg-line {
    position: relative;
    width: 100%;
    height: 2px;
    background: var(--brand, #0847f7);
  }
  .vac-leg-dashed {
    background: repeating-linear-gradient(90deg, var(--brand, #0847f7) 0 6px, transparent 6px 10px);
  }
  .vac .vac-leg-arrow {
    position: absolute;
    top: 50%;
    display: block;
    width: 18px;
    height: 18px;
    color: var(--brand, #0847f7);
    transform: translateY(-50%);
  }
  .vac .vac-leg-arrow svg {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }
  .vac-leg-out .vac-leg-arrow {
    right: -2px;
  }
  .vac-leg-back .vac-leg-arrow {
    left: -2px;
  }
  .vac .vac-leg-caption {
    display: none;
    padding: 0 4px;
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    line-height: 14px;
    text-align: center;
  }

  /* Hub cell contents */
  .vac .vac-link {
    display: grid;
    align-content: center;
    gap: 1px;
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    line-height: 14px;
    text-align: center;
    white-space: nowrap;
  }
  .vac .vac-link span {
    font-size: 11px;
    line-height: 14px;
  }
  /* Explanation row: step arrows beside the selected step's text */
  .vac-inspector-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 12px;
    border-top: 1px solid var(--border, #e4e8ed);
    background: var(--background, #ffffff);
  }
  .vac-steppers {
    display: flex;
    flex: none;
    gap: 4px;
  }
  .vac .vac-step-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--border, #e4e8ed);
    border-radius: 4px;
    background: var(--background, #ffffff);
    color: var(--foreground, #141921);
    cursor: pointer;
  }
  .vac .vac-step-btn svg {
    width: 16px;
    height: 16px;
    stroke-width: 2;
  }
  .vac .vac-step-btn:hover:not(:disabled) {
    border-color: var(--brand, #0847f7);
    background: var(--vac-accent-surface);
    color: var(--vac-accent-text);
  }
  .vac .vac-step-btn:disabled {
    color: var(--muted-foreground, #6c7585);
    cursor: default;
  }
  .vac .vac-inspector {
    flex: 1 1 auto;
    min-width: 0;
    padding-top: 4px;
    color: var(--color-text-primary, #4e5560);
    font-size: 12px;
    line-height: 16px;
  }
  .vac .vac-inspector strong {
    color: var(--foreground, #141921);
    font-size: 12px;
    line-height: 16px;
  }
  .vac .vac-inspector-step {
    display: inline-block;
    margin-right: 6px;
    padding: 0 6px;
    border-radius: 9px;
    background: var(--muted, #f5f7fa);
    color: var(--color-text-primary, #4e5560);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    white-space: nowrap;
  }
  .vac .vac-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin-top: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--border, #e4e8ed);
    color: var(--color-text-primary, #4e5560);
    font-size: 12px;
    line-height: 16px;
  }
  .vac .vac-legend .vac-badge {
    width: 18px;
    height: 18px;
    font-size: 10px;
  }
  .vac .vac-legend-switch {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--foreground, #141921);
  }
  .vac .vac-legend-switch svg {
    width: 16px;
    height: 16px;
  }
  .vac .vac-legend-dash {
    width: 18px;
    height: 0;
    border-top: 2px dashed var(--brand, #0847f7);
  }
  .vac-text[hidden] {
    display: none;
  }

  /* Wider containers: three real columns, captions and subtitles */
  @container vac (min-width: 600px) {
    .vac-columns,
    .vac-track {
      grid-template-columns: minmax(136px, 0.9fr) minmax(136px, 0.85fr) minmax(0, 2.1fr);
    }
    .vac .vac-col em {
      display: block;
    }
    .vac .vac-col-ccip {
      padding-inline: 10px;
      font-size: 12px;
      letter-spacing: 0.04em;
    }
    .vac .vac-col-full {
      display: inline;
    }
    .vac .vac-col-short {
      display: none;
    }
    .vac-row-head {
      flex-wrap: nowrap;
    }
    .vac-cell {
      padding: 20px 12px 12px;
    }
    .vac-cell-source .vac-node {
      justify-self: center;
      width: min(100%, 170px);
    }
    .vac-node {
      padding: 14px 10px 10px;
    }
    .vac .vac-chip {
      padding: 1px 8px;
    }
    .vac .vac-chip-full {
      display: inline;
    }
    .vac .vac-chip-short {
      display: none;
    }
    .vac .vac-leg-caption {
      display: block;
    }
    .vac-cell-hub {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
    .vac-cell-hub [data-node="hub-wallet"],
    .vac-cell-hub .vac-node-adapter {
      grid-column: 1;
      grid-row: 1;
    }
    .vac-cell-hub .vac-link-vault {
      grid-column: 2;
      grid-row: 1;
    }
    .vac-cell-hub .vac-node-vault {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .vac[data-ready="true"] .vac-node,
    .vac[data-ready="true"] .vac-badge,
    .vac[data-ready="true"] .vac-step-btn,
    .vac[data-ready="true"] .vac-leg-line,
    .vac[data-ready="true"] .vac-option-text {
      transition:
        background-color 210ms ease,
        border-color 210ms ease,
        box-shadow 210ms ease,
