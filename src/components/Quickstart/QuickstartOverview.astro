---
import { QuickstartsFrontmatter } from "~/content.config.ts"
interface Props {
  frontmatter: QuickstartsFrontmatter
}
const { frontmatter } = Astro.props
---

<h1 class="title">{frontmatter.title}</h1>
<h3 class="description">{frontmatter.description}</h3>

<style>
  * {
    max-width: 640px;
    margin-bottom: 0;
  }

  .title,
  .description {
    margin-top: var(--space-6x);
  }

  .description {
    color: #555c6c;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
  }

  @media (min-width: 48em) {
    .description {
      color: #252e42;
    }
  }
</style>
