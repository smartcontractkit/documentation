---
import { Sections } from "~/content.config"
import { SIDEBAR_WITH_SUNSET_PRODUCTS, CCIP_SIDEBARS } from "../../config"
import type { SectionEntry, SectionContent } from "../../config"
import { SIDEBAR_SECTIONS } from "../../config/sidebarSections.ts"
import { AI_AGENT_RESOURCES_SECTION, withParentQuery } from "../../config/sidebar/ai-agent-resources.ts"
import { getSolutionsSection } from "../../config/sidebar/solutions.ts"
import RecursiveSidebar from "./RecursiveSidebar.astro"
import { LanguageSwitcherDropdown } from "~/components/LanguageSwitcherDropdown"
import { ChainTypeSelector } from "~/components/ChainSelector"
import { CcipVersionToggle, CcipVersionBanner } from "~/components/CcipVersionToggle"
import { isChainAwareSection } from "~/config/chainTypes"
import {
  CCIP_VERSION_TOGGLE_ENABLED,
  LATEST_CCIP_VERSION,
  CCIP_VERSION_CONFIGS,
  type CcipVersionConfig,
} from "~/config/ccipVersions"
import type { CcipVersion } from "~/config/types"
import styles from "./leftSidebar.module.css"

type SectionEntryWithParent = SectionEntry & { parentSection?: string }

/** Sidebars that should not include the shared AI resources footer. */
const SECTIONS_WITHOUT_AI_RESOURCES = new Set<Sections>([
  SIDEBAR_SECTIONS.GLOBAL,
  SIDEBAR_SECTIONS.LEGACY,
  SIDEBAR_SECTIONS.CHAINLINK_PLATFORM,
])

/**
 * Sections whose pages render every product sidebar (hidden) and reveal the
 * matching one client-side via the `?parent=` query parameter. Their own
 * sidebar is shown by default when no `?parent=` is present.
 */
const SHARED_PAGE_SECTIONS = new Set<Sections>([SIDEBAR_SECTIONS.GLOBAL, SIDEBAR_SECTIONS.CHAINLINK_PLATFORM])

export type Props = {
  currentPage: string
  section?: Sections
}

const { currentPage, section } = Astro.props

// Check if this section supports chain type filtering
const showChainSelector = isChainAwareSection(section)

// Detect CCIP version from URL at build time for correct sidebar rendering
function detectCcipVersionFromPage(page: string): CcipVersion {
  for (const [versionId, config] of Object.entries(CCIP_VERSION_CONFIGS) as [CcipVersion, CcipVersionConfig][]) {
    if (
      config.urlPrefix &&
      (page.includes(`/ccip/${config.urlPrefix}/`) || page.endsWith(`/ccip/${config.urlPrefix}`))
    ) {
      return versionId
    }
  }
  return LATEST_CCIP_VERSION
}

// Return whichever sections we need
function getSidebarSections(section?: Sections): SectionEntryWithParent[] {
  if (!section) {
    return []
  } else if (SHARED_PAGE_SECTIONS.has(section)) {
    // Shared-page sections render every product sidebar (hidden) and reveal the
    // matching one client-side via `?parent=`. The section's own sidebar is
    // shown by default when no `?parent=` is present.
    return Object.entries(SIDEBAR_WITH_SUNSET_PRODUCTS).flatMap(([parentSection, entries]) => {
      const sections = entries?.map((entry) => ({ ...entry, parentSection: parentSection as Sections })) ?? []

      if (!SECTIONS_WITHOUT_AI_RESOURCES.has(parentSection as Sections)) {
        sections.push({
          ...withParentQuery(AI_AGENT_RESOURCES_SECTION, parentSection as Sections),
          parentSection: parentSection as Sections,
        })
      }

      const solutionsSection = getSolutionsSection(parentSection as Sections)
      if (solutionsSection) {
        // Insert before the AI resources group when present, else append, so Solutions sits above it.
        const hasAiResources = !SECTIONS_WITHOUT_AI_RESOURCES.has(parentSection as Sections)
        const insertAt = hasAiResources ? sections.length - 1 : sections.length
        sections.splice(insertAt, 0, {
          ...solutionsSection,
          parentSection: parentSection as Sections,
        })
      }

      return sections
    })
  }

  // For CCIP: use version-specific sidebar based on the current page URL
  if (section === "ccip") {
    const ccipVersion = detectCcipVersionFromPage(currentPage)
    const ccipSections = CCIP_SIDEBARS[ccipVersion] ?? SIDEBAR_WITH_SUNSET_PRODUCTS[section] ?? []

    if (SECTIONS_WITHOUT_AI_RESOURCES.has(section)) {
      return ccipSections
    }

    const ccipSolutionsSection = getSolutionsSection(section)

    return [
      ...ccipSections,
      ...(ccipSolutionsSection ? [ccipSolutionsSection] : []),
      withParentQuery(AI_AGENT_RESOURCES_SECTION, section),
    ]
  }

  const productSections = SIDEBAR_WITH_SUNSET_PRODUCTS[section] ?? []

  if (SECTIONS_WITHOUT_AI_RESOURCES.has(section)) {
    return productSections
  }

  const solutionsSection = getSolutionsSection(section)

  return [
    ...productSections,
    ...(solutionsSection ? [solutionsSection] : []),
    withParentQuery(AI_AGENT_RESOURCES_SECTION, section),
  ]
}

/**
 * Determines if a section should be expanded based on its contents
 */
function shouldExpandTopSection(contents: SectionEntry["contents"], currentPage: string): boolean {
  const normalizedCurrentPage = removeSlashes(currentPage.slice(1))

  // Helper function to check if an item or its children match the current page exactly
  function checkItem(item: SectionContent): boolean {
    // Check if current page matches this item exactly
    if (item.url) {
      const normalizedItemUrl = removeSlashes(item.url)

      // Direct match
      if (normalizedCurrentPage === normalizedItemUrl) {
        return true
      }

      // Check highlightAsCurrent array
      if (item.highlightAsCurrent?.some((url) => normalizedCurrentPage === removeSlashes(url))) {
        return true
      }
    }

    // Check children recursively for exact matches
    if (item.children) {
      return item.children.some(checkItem)
    }

    return false
  }

  // Check all items in the section for exact matches
  return contents.some(checkItem)
}

function removeSlashes(url: string): string {
  let sanitizedUrl = url
  sanitizedUrl = sanitizedUrl.split("?parent")[0]
  if (sanitizedUrl.charAt(0) == "/") sanitizedUrl = sanitizedUrl.substr(1)
  if (sanitizedUrl.charAt(sanitizedUrl.length - 1) == "/")
    sanitizedUrl = sanitizedUrl.substr(0, sanitizedUrl.length - 1)
  return sanitizedUrl
}

const sidebarSections = getSidebarSections(section)
---

<nav aria-labelledby="grid-left" class={styles.nav} data-section={section ?? ""}>
  {
    (showChainSelector || section === "cre") && (
      <div class={styles.sidebarDropdowns}>
        {section === "cre" && <LanguageSwitcherDropdown client:only="react" />}
        {showChainSelector && (
          <div class={styles.selectorRow}>
            <ChainTypeSelector client:only="react" />
            {CCIP_VERSION_TOGGLE_ENABLED && <CcipVersionToggle client:only="react" />}
          </div>
        )}
        {showChainSelector && CCIP_VERSION_TOGGLE_ENABLED && <CcipVersionBanner client:only="react" />}
      </div>
    )
  }
  <ul class={styles.navGroups} data-sticky>
    {
      sidebarSections.map((group) => {
        // On Chainlink Platform pages, the section's own group renders flat
        // (no collapsible dropdown); every other group keeps the dropdown.
        const isOwnPlatformGroup =
          section === SIDEBAR_SECTIONS.CHAINLINK_PLATFORM && group.parentSection === SIDEBAR_SECTIONS.CHAINLINK_PLATFORM
        return (
          <li
            style={SHARED_PAGE_SECTIONS.has(section) ? { display: "none" } : {}}
            class={group.parentSection ? `parent-${group.parentSection}` : ""}
          >
            {isOwnPlatformGroup ? (
              <RecursiveSidebar items={group.contents} currentPage={currentPage} />
            ) : (
              <details open={shouldExpandTopSection(group.contents, currentPage)}>
                <summary class={styles.navGroupTitle}>{group.section}</summary>
                <ul class={styles.navGroupEntries}>
                  <RecursiveSidebar items={group.contents} currentPage={currentPage} />
                </ul>
              </details>
            )}
          </li>
        )
      })
    }
  </ul>
</nav>

<script is:inline>
  // Shared pages render every product sidebar hidden; reveal the active one before paint.
  const nav = document.querySelector("nav[aria-labelledby='grid-left']")
  const section = new URLSearchParams(window.location.search).get("parent") || nav?.dataset.section
  for (const element of document.querySelectorAll(`.parent-${section}`)) element.style.display = "block"
</script>

<style is:global>
  .nav-link svg {
    min-height: 12px;
    min-width: 12px;
    opacity: 0;
    display: none;
  }

  .nav-link[aria-current="page"] svg {
    opacity: 0;
  }
</style>

<script>
  import { initializeChainType } from "~/stores/chainType.js"
  import { initializeCcipVersion } from "~/stores/ccipVersion.js"

  /**
   * Initialize chain type and CCIP version selection from URL on page load
   * This detects the chain from the URL path (e.g., /ccip/evm/... → evm)
   * and the version (e.g., /ccip/v1/... → v1.6, no prefix → latest)
   */
  initializeChainType()
  initializeCcipVersion()

  /**
   * Re-initialize on client-side navigation (Astro view transitions)
   */
  document.addEventListener("astro:after-swap", () => {
    initializeChainType()
    initializeCcipVersion()
  })

  /**
   * Handles section visibility based on URL parameters
   * - Shows/hides sections based on the 'parent' query parameter
   * - Runs on initial load and after navigation
   */
  const attachContentScripts = () => {
    const nav = document.querySelector<HTMLElement>("nav[aria-labelledby='grid-left']")
    const ownSection = nav?.dataset.section
    const parentSection = new URLSearchParams(window.location.search).get("parent")
    // Arrived from a product sidebar: reveal that product's groups. Otherwise
    // reveal the current section's own sidebar groups (e.g. the Chainlink
    // Platform sidebar on /chainlink-platform pages, or General's groups).
    const sectionToReveal = parentSection || ownSection
    if (sectionToReveal) {
      for (let elem of document.querySelectorAll(`.parent-${sectionToReveal}`)) {
        ;(elem as HTMLElement).style.display = "block"
      }
    }
  }

  // Runs on initial navigation
  attachContentScripts()
  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", attachContentScripts)
</script>

<script>
  import { selectedChainType } from "~/stores/chainType.js"

  /**
   * Filters sidebar items based on selected chain type
   * Triggers the unified filter in RecursiveSidebar that respects BOTH chain type AND language
   */
  function runUnifiedSidebarFilter() {
    // Trigger the unified filter (RecursiveSidebar listens for this)
    window.dispatchEvent(new CustomEvent("languageChanged"))
  }

  // Run on initial load
  runUnifiedSidebarFilter()

  // Run after view transitions
  document.addEventListener("astro:after-swap", runUnifiedSidebarFilter)

  // Subscribe to chain type changes (store)
  selectedChainType.subscribe(() => {
    runUnifiedSidebarFilter()
  })

  // Also respond to explicit chain-change events (e.g., from React dropdowns)
  window.addEventListener("chainTypeChanged", runUnifiedSidebarFilter)
</script>
