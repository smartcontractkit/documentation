---
import { JourneyCardsDesktop } from "./JourneyCardsDesktop.tsx"
import { JourneyTabGrid } from "./JourneyTabGrid.tsx"

// Card order in each column: CRE, CCIP, Data Streams, ACE, then the remaining products alphabetically.
// (The product filter dropdown is sorted alphabetically on its own.)
const columns = [
  {
    title: "Learn & Explore",
    items: [
      {
        title: "Understand the Chainlink Runtime Environment",
        description: "Learn how workflows, triggers, capabilities, and DON consensus fit together.",
        badge: "cre",
        href: "/cre/overview",
      },
      {
        title: "Explore Cross-Chain Interoperability with CCIP",
        description: "Learn cross-chain concepts, workflows, and real-world use cases.",
        badge: "ccip",
        href: "/ccip/overview",
      },
      {
        title: "Learn How Data Streams Deliver Real-Time Data",
        description: "Understand how low-latency streams support time-sensitive applications.",
        badge: "data streams",
        href: "/data-streams",
      },
      {
        title: "Discover Automated Compliance with ACE",
        description: "Learn how ACE brings policy management and cross-chain identity to smart contracts.",
        badge: "ace",
        href: "/ace/overview",
      },
      {
        title: "Explore Verifiable Events and Gas-Less Operations",
        description: "Learn the core model: channels, watchers, smart accounts, operations, and queries.",
        badge: "cre connect",
        href: "/crec/overview",
      },
      {
        title: "Understand How Data Feeds Power dApps",
        description: "See how oracle data feeds deliver price feeds and reference data.",
        badge: "data feeds",
        href: "/data-feeds",
      },
      {
        title: "Learn How DataLink Brings Specialized Data Onchain",
        description: "See how providers publish institutional-grade market data through Chainlink.",
        badge: "datalink",
        href: "/datalink",
      },
      {
        title: "Discover How the DTA Technical Standard Works",
        description: "Explore the architecture and subscription/redemption flows for tokenized funds.",
        badge: "dta",
        href: "/dta-technical-standard/how-it-works",
      },
    ],
  },
  {
    title: "Build & Integrate",
    items: [
      {
        title: "Build Your First CRE Workflow",
        description: "Follow the tutorial series to fetch APIs, read contracts, and write onchain.",
        badge: "cre",
        href: "/cre/getting-started/overview",
      },
      {
        title: "Build Cross-Chain Apps with CCIP Tutorials",
        description: "Follow step-by-step guides with language switching (EVM, Rust, Move, etc.).",
        badge: "ccip",
        href: "/ccip/evm/tutorials",
      },
      {
        title: "Implement Real-Time Use Cases with Data Streams",
        description: "Use low-latency data in trading, gaming, and other live applications.",
        badge: "data streams",
        href: "/data-streams/tutorials/overview",
      },
      {
        title: "Get Started with ACE Policy and Identity Managers",
        description: "Pick your onboarding path and enforce your first compliance policy onchain.",
        badge: "ace",
        href: "/ace/getting-started",
      },
      {
        title: "Watch Onchain Events with the CRE Connect SDK",
        description: "Create a channel and watcher, then verify and decode your first events in Go.",
        badge: "cre connect",
        href: "/crec/getting-started/quickstart-watch-events",
      },
      {
        title: "Integrate Data Feeds into Smart Contracts",
        description: "Plug feeds into your apps with examples and addresses.",
        badge: "data feeds",
        href: "/data-feeds/using-data-feeds",
      },
      {
        title: "Integrate DataLink Feeds into Your App",
        description: "Fetch, decode, and verify DataLink reports with Go, Rust, or onchain contracts.",
        badge: "datalink",
        href: "/datalink/pull-delivery/tutorials",
      },
      {
        title: "Integrate DTA with the CRE Connect Extension",
        description: "Use typed operations and decoded events to drive DTA contracts from Go.",
        badge: "dta",
        href: "/crec/extensions/dta",
      },
    ],
  },
  {
    title: "Operate & Scale",
    items: [
      {
        title: "Deploy Workflows to Production",
        description: "Choose a registry model and ship your workflows to the CRE network.",
        badge: "cre",
        href: "/cre/guides/operations/deploying-workflows",
      },
      {
        title: "Monitor CCIP Transactions in Real Time",
        description: "Track the progress and status of cross-chain transactions.",
        badge: "ccip",
        href: "https://ccip.chain.link/",
      },
      {
        title: "Deliver Reliable Low-Latency Data with Streams",
        description: "Operate Data Streams at scale for critical, time-sensitive use cases.",
        badge: "data streams",
        href: "/data-streams/concepts/best-practices",
      },
      {
        title: "Produce Audit-Ready Compliance Reports",
        description: "Query policy runs, identities, and credentials with historical snapshots for regulators.",
        badge: "ace",
        href: "/ace/concepts/reporting",
      },
      {
        title: "Verify Every Event Before Processing",
        description: "Cryptographically authenticate events to keep production integrations secure.",
        badge: "cre connect",
        href: "/crec/guides/events/verify-signatures",
      },
      {
        title: "Select Quality Data Feeds",
        description: "Evaluate and maintain data feed quality for accurate, reliable integrations.",
        badge: "data feeds",
        href: "/data-feeds/selecting-data-feeds",
      },
      {
        title: "Understand DataLink Data Quality and Trust",
        description: "Review who is responsible for data quality and what it means for your integration.",
        badge: "datalink",
        href: "/datalink/data-quality-responsibility",
      },
      {
        title: "Track Requests Through the DTA Lifecycle",
        description: "Follow subscription and redemption requests from submission to settlement.",
        badge: "dta",
        href: "/dta-technical-standard/concepts/request-lifecycle",
      },
    ],
  },
]

// Transform columns to tabs format for JourneyTabGrid
const tabs = columns.map((column) => ({
  name: column.title,
  items: column.items.map((item) => ({
    title: item.title,
    description: item.description,
    link: item.href,
    badge: item.badge,
  })),
}))
---

<section>
  <section class="desktop">
    <JourneyCardsDesktop columns={columns} client:load />
  </section>
  <section class="mobile">
    <JourneyTabGrid header="Start your Chainlink journey" tabs={tabs} client:only="react" />
  </section>
</section>

<style>
  .desktop {
    display: none;
  }

  .mobile {
    display: block;
  }

  @media (min-width: 769px) {
    .desktop {
      display: block;
    }

    .mobile {
      display: none;
    }
  }
</style>
