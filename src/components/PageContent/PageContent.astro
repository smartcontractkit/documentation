---
import { MarkdownHeading } from "astro"

export type Props = {
  titleHeading: MarkdownHeading
  disableDefaultStyles?: boolean
  hideTitle?: boolean
}
const { titleHeading, disableDefaultStyles, hideTitle } = Astro.props
---

<article id="article" data-disable-default-styles={disableDefaultStyles || undefined}>
  <h1 id={titleHeading.slug} class:list={{ "sr-only": hideTitle }}>{titleHeading.text}</h1>

  <slot />
</article>

<style is:inline>
  /* Screen reader only - visually hidden but accessible */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Using padding instead of margin so intersection observers work without spaces */
  :where(article:not([data-disable-default-styles]), astro-island, astro-slot) > section {
    padding-top: var(--space-5x);
  }

  /* Default content styles - opt-out with disableDefaultStyles prop for custom layouts like ccip/index.mdx */
  article:not([data-disable-default-styles]) {
    :is(h1, h2, h3, h4, h5, h6) > a {
      display: inline-block;
      color: inherit;
      width: 100%;
    }

    astro-slot > :first-child {
      margin-top: 0;
    }

    /*
      This is a bit of trickery that keeps the content
      from shifting in the time between the DOM hydrating and the
      wrapper script finishing. The margin is supplemented
      by the section padding once the wrapper is created

      This also keeps the spacing intact
      in case JS isn't loading on the page
    */
    > :where(h1, h2) {
      margin-top: var(--space-5x) !important;
    }

    * {
      max-width: 100%;
      margin-bottom: 0;
    }

    a:not(:is(h1 a, h2 a, h3 a, h4 a, h5 a, h6 a)) {
      color: var(--color-text-link);
    }

    :is(h1, h2, h3, h4, h5, h6, p, li) {
      word-break: break-word;
    }

    p {
      margin-bottom: 0;
    }

    :is(p, li) {
      line-height: 28px;
    }

    label {
      display: flex;
      align-items: center;
      gap: var(--space-2x);
    }

    :is(ul, ol) {
      margin-top: var(--space-3x);

      > li,
      > li > :is(ul, ol) {
        margin-top: var(--space-2x);
      }
    }

    li {
      list-style-type: disc;

      > * {
        margin-top: var(--space-2x);
      }

      /* Offset line-height difference */
      > :not(p):last-child {
        margin-bottom: var(--space-3x);
      }
    }

    ul {
      padding-left: calc(var(--space-4x) + 2px);
    }

    ol {
      padding-left: var(--space-8x);

      > li {
        list-style-type: decimal;
      }
    }

    ::marker {
      font-weight: bold;
      color: var(--theme-text-light);
    }

    iframe {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    /* Offsets padding */
    :is(section, h5, h6):target {
      scroll-margin-top: var(--theme-navbar-height);
    }

    /* Shared styles for article, section, and astro-slot contexts */
    :where(&, & section, & astro-slot, & astro-island) {
      > :not(section, astro-slot, astro-island, astro-accordion, astro-anchored-accordion) {
        margin-top: var(--space-5x);
      }

      > pre {
        margin-top: var(--space-2x);
      }
    }

    /*
      Accordions are deliberately excluded from the top-margin rhythm above, so that a
      run of stacked accordions stays flush and reads as one continuous list. The side
      effect is that the FIRST accordion of a run sits jammed against whatever precedes
      it (e.g. a DocCards grid). Fix it the same way Quickstart.astro and
      CRETemplate.astro already do: the preceding element supplies the gap via :has().

      Headings are excluded because they already carry their own padding-bottom, and an
      accordion run reads better hugging the heading it belongs to.

      NOTE: :is() here is load-bearing — do not "tidy" it to :where(). The
      `* { margin-bottom: 0 }` reset above is specificity (0,1,1); :where() would zero
      the parent out and this rule would silently lose at (0,0,2). That is exactly why a
      plain `margin-bottom` on a component's own class (e.g. .cards) has no effect here.
    */
    :is(&, & section, & astro-slot, & astro-island)
      > :not(astro-accordion, astro-anchored-accordion, h1, h2, h3, h4, h5, h6):has(
        + :is(astro-accordion, astro-anchored-accordion)
      ) {
      margin-bottom: var(--space-5x);
    }

    :where(&, & section) {
      > :is(h1, h2, h3) + :not(section, astro-slot, astro-island, astro-accordion, astro-anchored-accordion, h5, h6) {
        margin-top: var(--space-5x) !important;
      }

      > :is(h4, h5, h6) + :not(section, astro-slot, astro-island, astro-accordion, astro-anchored-accordion) {
        margin-top: var(--space-3x) !important;
      }
    }

    :where(&, & section, & astro-slot) {
      > :is(h1, h2, h3, h4, h5, h6, li) {
        font-weight: bold;
        margin-top: 0;
      }

      > h1 {
        font-size: 32px;
      }

      > h2 {
        padding-top: var(--space-6x);
        font-size: 28px;
      }

      > h3 {
        padding-top: var(--space-8x);
        font-size: 24px;
      }

      > h4 {
        padding-top: var(--space-5x);
        font-size: 20px;
      }

      > :is(h5, h6) {
        padding-top: var(--space-4x);
        font-size: 16px;
      }
    }

    /* Match heading typography inside accordion content; keep spacing tighter than article flow */
    :is(astro-accordion, astro-anchored-accordion) .accordionContent {
      > :is(h3, h4, h5, h6) {
        font-weight: bold;
        margin-top: 0;
      }

      > h3 {
        padding-top: var(--space-4x);
        font-size: 24px;
      }

      > h4 {
        padding-top: var(--space-3x);
        font-size: 20px;
      }

      > :is(h5, h6) {
        padding-top: var(--space-2x);
        font-size: 16px;
      }
    }

    astro-anchored-accordion .accordionContent > :is(h3, h4, h5, h6):first-child {
      padding-top: 0;
    }

    @media (min-width: 50em) {
      :where(&, & section, & astro-slot) > :is(h1, h2) {
        position: sticky;
        top: 0;
        z-index: 3;
        background: white;
        border-bottom: 2px solid var(--blue-200, #dfe7fb);
        padding: var(--space-6x) 0;
      }

      section > :is(section, h5, h6):target {
        scroll-margin-top: calc(var(--theme-navbar-height) + var(--space-20x));
      }

      :where(&, & section, & astro-slot) > h3 {
        padding-top: var(--space-8x);
      }

      :where(&, & section, & astro-slot) > h4 {
        padding-top: var(--space-6x);
      }
    }

    @media (min-width: 72em) {
      :where(&, & section, & astro-slot) > h1 {
        font-size: 40px;
      }

      :where(&, & section, & astro-slot) > h2 {
        font-size: 32px;
      }

      :where(&, & section, & astro-slot) > h3 {
        font-size: 28px;
      }

      :is(astro-accordion, astro-anchored-accordion) .accordionContent > h3 {
        font-size: 28px;
      }
    }
  }
</style>

<script>
  import { prepareSections } from "../../scripts/prepArticleContent.ts"

  // Runs on initial navigation
  prepareSections()
  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => prepareSections())
</script>
