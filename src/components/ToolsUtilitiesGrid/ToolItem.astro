---
import { Typography } from "@chainlink/blocks"
import styles from "./toolsUtilities.module.css"
import { Link } from "./types"

type Props = Link

const { description, image, imageAlt, label, link, comingSoon } = Astro.props
const isLink = !comingSoon && Boolean(link)
const Element = isLink ? "a" : "div"
---

<Element {...isLink ? { href: link } : {}} class:list={[styles.card, comingSoon && styles.comingSoon]}>
  <div class={styles.imageContainer}><img src={image} alt={imageAlt} class={styles.image} /></div>

  <div class={styles.content}>
    <div>
      <Typography
        variant="body-semi"
        style={{
          fontWeight: 500,
          fontSize: "18px",
        }}>{label}</Typography
      >
      <Typography variant="body-s" color="muted">{description}</Typography>
      {comingSoon && <span class={styles.badge}>Coming soon</span>}
    </div>

    {isLink && <img src="/assets/icons/upper-right-arrow.svg" class={styles.arrow} />}
  </div>
</Element>
