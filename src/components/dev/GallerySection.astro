---
/** Collapsible product group; `id` is the nav anchor, `label` marks shared groups. */
interface Props {
  id: string
  title: string
  description?: string
  label?: string
  open?: boolean
}

const { id, title, description, label, open = true } = Astro.props
---

<section class="gallery-section" id={id}>
  <details open={open}>
    <summary>
      <span class="gallery-section__title">{title}</span>
      {label && <span class="gallery-section__label">{label}</span>}
      {description && <span class="gallery-section__description">{description}</span>}
      <span class="gallery-section__chevron" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </span>
    </summary>
    <div class="gallery-section__body">
      <slot />
    </div>
  </details>
</section>

<style>
  .gallery-section {
    margin-block: 2rem;
    scroll-margin-top: calc(var(--gallery-header-h, 80px) + 1rem);
  }

  .gallery-section > details {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--background);
    overflow: hidden;
  }

  .gallery-section > details > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    padding: 0.85rem 1rem;
    background: var(--background-alt);
    cursor: pointer;
    list-style: none;
  }

  .gallery-section > details > summary::-webkit-details-marker {
    display: none;
  }

  .gallery-section > details[open] > summary {
    border-bottom: 1px solid var(--border);
  }

  .gallery-section__title {
    color: var(--foreground);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .gallery-section__label {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .gallery-section__description {
    flex-basis: 100%;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .gallery-section__chevron {
    display: inline-flex;
    align-self: center;
    margin-left: auto;
    color: var(--muted-foreground);
    transition: transform 120ms ease;
  }

  .gallery-section > details[open] .gallery-section__chevron {
    transform: rotate(180deg);
  }

  .gallery-section__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.25rem 1.5rem;
  }

  /* Specimens already carry their own top margin; tighten inside a grouped section. */
  .gallery-section__body :global(.specimen) {
    margin-block: 0.75rem;
  }
</style>
