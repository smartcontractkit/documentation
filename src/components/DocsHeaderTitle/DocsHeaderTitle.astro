---
import { getNavigationProps } from "../Header/getNavigationProps"
import { isMatchedPath } from "../Header/Nav/isMatchedPath"
import defaultLogo from "../../assets/product-logos/default-logo.svg"
import styles from "./docsHeaderTitle.module.css"
import { Typography } from "@chainlink/blocks"

interface Props {
  pathname: string
}

const propsPath = Astro.props.pathname
const runtimePath = Astro.url?.pathname
const rawPath = runtimePath || propsPath || "/"

function normalizePath(p: string): string {
  let s = p.startsWith("/") ? p : `/${p}`
  s = s.split("?")[0].split("#")[0]
  if (s.length > 1 && s.endsWith("/")) s = s.slice(0, -1)
  return s
}

const normalizedPath = normalizePath(rawPath)

const isCcip = /^\/ccip(\/|$)/.test(normalizedPath)
const isCcipV1 = /^\/ccip\/v1(\/|$)/.test(normalizedPath)

// Treat these as “landing” for highlighting purposes.
// This covers setups where the index route is emitted as /ccip/index (or .html).
function isCcipLandingPath(path: string): boolean {
  const p = normalizePath(path)
  if (p === "/ccip" || p === "/ccip/index" || p === "/ccip/index.html") return true
  if (p === "/ccip/v1" || p === "/ccip/v1/index" || p === "/ccip/v1/index.html") return true
  return false
}

const isCcipLanding = isCcipLandingPath(normalizedPath)

// Version-aware home href
const ccipHomeHref = isCcipV1 ? "/ccip/v1" : "/ccip"

const { subProductsNav } = getNavigationProps()
const subProductTrigger = subProductsNav?.find(({ href }) => isMatchedPath(normalizedPath, href))

const label = subProductTrigger?.label || (isCcip ? "CCIP" : "Resources")
const icon = subProductTrigger?.label ? subProductTrigger.icon : defaultLogo.src
---

{
  isCcip ? (
    <a
      href={ccipHomeHref}
      class={`nav-link ${styles.docsHeaderTitleWrapper}`}
      aria-label="CCIP home"
      aria-current={isCcipLanding ? "page" : undefined}
    >
      <img src={icon} alt="" class={styles.logo} />
      <Typography variant="body-semi-l">{label}</Typography>
    </a>
  ) : (
    <div class={styles.docsHeaderTitleWrapper}>
      <img src={icon} alt="" class={styles.logo} />
      <Typography variant="body-semi-l">{label}</Typography>
    </div>
  )
}
