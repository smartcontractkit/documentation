---
import type { MarkdownHeading } from "astro"
import BaseLayout from "./BaseLayout.astro"
import PageContent from "~/components/PageContent/PageContent.astro"
import StickyHeader from "~/components/StickyHeader/StickyHeader"
import TableOfContents from "~/components/TableOfContents/TableOfContents"
import { CopyPageLink } from "~/components/RightSidebar/CopyPageLink"
import SolutionNavigation from "~/components/Solutions/SolutionNavigation.astro"
import SolutionSidebar from "~/components/Solutions/SolutionSidebar.astro"
import SolutionSummary from "~/components/Solutions/SolutionSummary.astro"
import SolutionDisclaimer from "~/components/Solutions/SolutionDisclaimer.astro"
import { getSolutionPages, buildSolutionNav } from "~/utils/solutions"
import * as CONFIG from "~/config"
import type { Solution } from "~/config/solutions/index.ts"
import type { SolutionsFrontmatter } from "~/content.config.ts"

interface Props {
  solution: Solution
  frontmatter: SolutionsFrontmatter
  headings?: MarkdownHeading[]
  /** "index" for the landing page, otherwise the page id, e.g. "overview/how-it-works". */
  pageId: string
}

const { solution, frontmatter, headings, pageId } = Astro.props

const pages = await getSolutionPages(solution.slug)
const navGroups = buildSolutionNav(solution, pages)
const hasSidebar = navGroups !== null
const isLanding = pageId === "index"

const titleHeading: MarkdownHeading = { text: frontmatter.title, slug: "overview", depth: 1 }
const initialHeadings = [titleHeading].concat((headings ?? []).filter((h) => h.depth < 5))

const currentPage = new URL(Astro.request.url).pathname
const formattedTitle = `${frontmatter.title} | ${solution.title} | ${CONFIG.SITE.title}`
---

<BaseLayout
  title={formattedTitle}
  metadata={{
    title: frontmatter.metadata?.title ?? frontmatter.title,
    description: frontmatter.metadata?.description ?? frontmatter.description ?? solution.description,
    image: frontmatter.metadata?.image ?? solution.image,
  }}
  pageTitle={frontmatter.title}
>
  <link slot="head" rel="alternate" type="text/markdown" href={`${currentPage}.md`} />

  <StickyHeader client:media="(max-width: 50em)" {initialHeadings} />
  <SolutionNavigation {solution} groups={navGroups} {currentPage} />

  <main class:list={[{ "main--no-sidebar": !hasSidebar }]}>
    {hasSidebar && <div id="left-bg" />}
    <div class:list={["layout", { "layout--no-sidebar": !hasSidebar }]}>
      {
        hasSidebar && (
          <aside id="grid-left">
            <SolutionSidebar {solution} groups={navGroups!} {currentPage} />
          </aside>
        )
      }

      <div id="grid-main">
        <PageContent {titleHeading}>
          {isLanding && <SolutionSummary {solution} />}
          <slot />
        </PageContent>

        <SolutionDisclaimer />
      </div>

      <aside id="grid-right">
        <section class="sidebar-nav" data-sticky>
          <div class="copy-page-wrapper">
            <CopyPageLink client:only="react" />
          </div>
          <h2 class="heading">On this page</h2>
          <div class="toc-wrapper">
            <TableOfContents client:media="(min-width: 50em)" initialHeadings={initialHeadings} />
          </div>
        </section>
      </aside>
    </div>
  </main>

  <style>
    /* Everything down to the marked section is copied verbatim from
       src/layouts/DocsLayout.astro:117-195. Do not modify it: it is the docs grid. */
    main {
      margin-bottom: 0 !important;
    }

    .layout {
      display: grid;
      grid-template-columns: auto;
      --gutter: var(--space-6x);
      --doc-padding: var(--space-6x);
      margin-bottom: 0;
    }

    #grid-left,
    #grid-right {
      display: none;
    }

    #grid-main {
      padding: var(--doc-padding) var(--gutter);
      display: flex;
      flex-direction: column;
      margin-bottom: var(--space-10x);
      min-width: 0;
    }

    @media (min-width: 50em) {
      main {
        display: grid;
        grid-template-columns: auto fit-content(100%) auto;
      }

      .layout {
        grid-template-columns: auto 1fr auto;
        gap: var(--gutter);
        width: 100vw;
        max-width: 1505px;
      }

      #grid-left,
      #left-bg {
        background: #fafbfd;
      }

      #grid-left,
      #grid-right {
        display: flex;
      }

      #grid-main {
        padding: 0 0 var(--doc-padding) 0;
      }

      #grid-left {
        width: 260px;
        padding-left: var(--space-6x);
      }

      #grid-right {
        width: 0;
        padding-right: 0;
        transition: 300ms ease-in-out;
        transition-property: width padding-right;
      }
    }

    @media (min-width: 992px) {
      .layout {
        gap: var(--doc-padding);
      }

      #grid-left {
        width: 350px;
        padding-left: var(--space-6x);
      }
    }

    @media (min-width: 1200px) {
      #grid-right {
        width: 315px;
        padding-right: var(--space-16x);
      }
    }

    .sidebar-nav {
      height: fit-content;
      padding: var(--doc-padding) 0;
      position: sticky;
      top: 80px;
      min-width: calc(315px - var(--space-16x));
    }

    .heading {
      margin-bottom: 0;
      color: var(--gray-900, #141921);
      font-size: 10px;
      font-weight: 500;
      line-height: 130%;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Same spacing as RightSidebar.astro so the rail reads identically on docs and
       solutions pages. */
    .copy-page-wrapper {
      margin-bottom: var(--space-6x);
    }

    .toc-wrapper {
      margin-bottom: var(--space-8x);
    }

    /* ---- single-page variant ----
       Single-page solutions have no left column. The docs grid on `main` (copied above)
       exists to position a full-width `.layout` between the two sidebars; with no left
       sidebar there is nothing to offset, so the grid is dropped.

       The block spans the SAME total width as the multi-page variant (max-width 1505px,
       centred): single- and multi-page solutions must occupy the same visual envelope.
       The left sidebar's width is redistributed: the content column is wider than the
       docs one, and the right rail is elastic instead of capped at 315px. The left edge
       stays aligned with the site header logo and the solution title bar. */
    @media (min-width: 50em) {
      main.main--no-sidebar {
        display: block;
      }

      /* Below 1200px the docs layout collapses its right rail to width 0; mirror that so
         the content is not squeezed by an unusably thin TOC on mid-size screens. */
      .layout--no-sidebar {
        grid-template-columns: minmax(0, 1fr);
        width: 100%;
        max-width: 1505px;
        margin: 0 auto;
        padding: 0 var(--space-8x) var(--doc-padding) var(--space-8x);
      }

      .layout--no-sidebar #grid-main {
        padding: var(--doc-padding) 0 var(--doc-padding) 0;
      }

      .layout--no-sidebar #grid-right {
        display: none;
      }
    }

    @media (min-width: 1200px) {
      .layout--no-sidebar {
        grid-template-columns: minmax(0, 1fr) 443px;
        gap: var(--doc-padding);
      }

      .layout--no-sidebar #grid-right {
        display: flex;
        width: auto;
        padding-right: 0;
      }
    }
  </style>
</BaseLayout>
