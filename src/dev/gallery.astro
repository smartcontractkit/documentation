              <HeavyPreview
                title="ACE manage policies"
                description="PolicyInstanceBuilder in its real article context."
                path="/ace/guides/policy-manager/manage-policies"
                theme={forcedTheme}
              />
              <HeavyPreview
                title="CRE docs"
                description="CRE template layout, code blocks, callouts and navigation."
