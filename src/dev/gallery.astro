              <HeavyPreview
                title="Changelog page"
                description="Changelog cards, filters and Algolia-driven list."
                path="/changelog"
                theme={forcedTheme}
              />
            </GallerySection>

            <GallerySection id="landing" title="Landing" description="Marketing/landing sections and solution layouts.">
              <HeavyPreview
                title="Landing page"
                description="LandingHero, JourneyCards, MediaSection, CommunityEvents and demos."
                path="/"
                theme={forcedTheme}
              />
              <HeavyPreview
                title="Solutions layout"
                description="SolutionLayout, cards and disclaimer."
                path="/solutions/cross-chain-vault-adapter"
                theme={forcedTheme}
              />
            </GallerySection>
          </PageContent>
        </main>
      )
    }

    <script is:inline>
      const galleryHeader = document.querySelector(".gallery-header")
      const syncHeaderHeight = () => {
        if (galleryHeader) {
          document.documentElement.style.setProperty(
            "--gallery-header-h",
            `${galleryHeader.getBoundingClientRect().height}px`
          )
        }
      }
      syncHeaderHeight()
      window.addEventListener("resize", syncHeaderHeight)

      // Open a collapsed group before the browser scrolls to it.
      for (const link of document.querySelectorAll('.gallery-nav a[href^="#"]')) {
        link.addEventListener("click", () => {
          const section = document.querySelector(link.getAttribute("href"))
          const details = section?.querySelector("details")
          if (details) details.open = true
        })
      }

      const setAllGroups = (open) => {
        for (const details of document.querySelectorAll(".gallery-section > details")) details.open = open
      }
      document.querySelector("[data-expand-all]")?.addEventListener("click", () => setAllGroups(true))
      document.querySelector("[data-collapse-all]")?.addEventListener("click", () => setAllGroups(false))

      for (const details of document.querySelectorAll(".gallery-heavy")) {
        details.addEventListener("toggle", () => {
          if (!details.open) return
          const frame = details.querySelector("iframe")
          if (frame && !frame.getAttribute("src")) frame.setAttribute("src", frame.dataset.heavySrc)
        })
      }

      for (const chip of document.querySelectorAll(".gallery-chip[data-token]")) {
        const cs = getComputedStyle(chip)
        const kind = chip.getAttribute("data-kind")
        const value = kind === "bg" ? cs.backgroundColor : kind === "fg" ? cs.color : cs.borderTopColor
        const out = chip.closest(".gallery-swatch")?.querySelector("[data-value]")
        if (out) out.textContent = value
      }

      const demo = document.querySelector("[data-rlb-demo]")
      if (demo) {
        const status = demo.querySelector(".rlb-status")
        const title = demo.querySelector('[data-part="status-title"]')
        const detail = demo.querySelector('[data-part="status-detail"]')
        const error = demo.querySelector('[data-part="status-error"]')
        const code = demo.querySelector('[data-part="status-code"]')
        const messages = {
          neutral: {
            title: "Adjust the sliders",
            detail: "Change capacity, refill rate or transfer amount to see the bucket react.",
          },
          info: {
            title: "Rate limit updated",
            detail: "Changing the capacity or refill rate resets the bucket to its new max capacity.",
          },
          success: {
            title: "Transfer accepted",
            detail: "10,000 tokens consumed. 90,000 of 100,000 remain, refilling at 1,000 tokens/s.",
          },
          warning: {
            title: "Transfer reverted",
            detail: "Only 16,832 tokens are available right now. Enough capacity refills within 1 min 14 s.",
            error: "TokenRateLimitReached",
          },
          error: {
            title: "Transfer reverted",
            detail: "100,000 is more than the max capacity of 50,000. This transfer can never succeed.",
            error: "TokenRateLimitReached",
          },
        }
        for (const button of demo.querySelectorAll("[data-set-tone]")) {
          button.addEventListener("click", () => {
            const tone = button.getAttribute("data-set-tone")
            const message = messages[tone] || messages.neutral
            if (!status || !title || !detail || !error || !code) return
            status.setAttribute("data-tone", tone)
            title.textContent = message.title
            detail.textContent = message.detail
            code.textContent = message.error || ""
            error.hidden = !message.error
          })
        }
      }
    </script>
  </body>
</html>
