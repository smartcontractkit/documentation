#!/usr/bin/env sh

changed_files=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD)

if [ -z "$changed_files" ]; then
  exit 0
fi

# Only run Prettier on files it can parse (skip shell scripts, etc.)
format_files=$(echo "$changed_files" | grep -E '\.(js|jsx|ts|tsx|json|css|md|mdx|yml|yaml|astro)$' || true)
if [ -n "$format_files" ]; then
  npx prettier --write $format_files
fi

code_files=$(echo "$changed_files" | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$code_files" ]; then
  npx eslint --fix $code_files
fi

if [ -n "$(git diff --name-only)" ]; then
  echo "\nAuto-formatted changed files. Review and re-commit."
  exit 1
fi